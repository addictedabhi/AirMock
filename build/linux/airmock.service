[Unit]
Description=AirMock — cross-protocol API mocking tool
After=network.target

[Service]
Type=simple
User=airmock
Group=airmock
# --admin-host 0.0.0.0 keeps the admin UI reachable from other machines, as
# earlier packages did; AirMock logs a warning at start if login is then off.
# Use 127.0.0.1 to keep it local-only.
ExecStart=/usr/bin/airmock serve --data-dir /var/lib/airmock --headless --admin-host 0.0.0.0
Restart=on-failure
RestartSec=2
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
